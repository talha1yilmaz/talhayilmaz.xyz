{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node",
      "vite/client"
    ],
    "noEmit": true,
    "resolveJsonModule": true
  },
  "include": [
    "shared",
    "admin",
    "scripts",
    "tests",
    "vite.admin.ts"
  ]
}