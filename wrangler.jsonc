{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "talha-site-admin",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist-admin",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "ADMIN_ORIGIN": "https://admin.talhayilmaz.xyz",
    "GITHUB_OWNER": "talha1yilmaz",
    "GITHUB_REPO": "talhayilmaz.xyz",
    "GITHUB_BRANCH": "master",
    "ALLOWED_USER_ID": "82741262",
    "GITHUB_CLIENT_ID": "Iv23liyiDbTFeEWXs80p",
    "GITHUB_APP_ID": "5065188",
    "GITHUB_INSTALLATION_ID": "164567186"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "talha-site-admin",
      "database_id": "29ecdcfe-45c0-4110-b0e4-7cc5e1ebbdbc",
      "migrations_dir": "worker/migrations"
    }
  ],
  "account_id": "95a7fc5eb11a2504d863064b2ea8cafd",
  "routes": [
    {
      "pattern": "admin.talhayilmaz.xyz",
      "custom_domain": true
    }
  ],
  "dev": {
    "ip": "127.0.0.1",
    "port": 8787,
    "host": "127.0.0.1:8787",
    "upstream_protocol": "http"
  }
}